# Local dev only — production VPS .env should NOT include PORT
PORT=3001

# Local Postgres connection (adjust if your local user/pw differs)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/designer_task_scheduler

# App-shared password (assigners log in with this; identity then picked from name dropdown).
# Bcrypt-hashed automatically on first run if the row in `settings` is missing.
APP_SHARED_PASSWORD=changeme

# Zoho Projects API (fill in once OAuth client is created — leave blank for now)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_PORTAL_ID=
ZOHO_DESIGNING_TAG_ID=
